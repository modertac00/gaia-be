{
  "name": "gaia-be",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "db:migrate": "ts-node -r tsconfig-paths/register scripts/migrate.ts",
    "db:migrate:up": "ts-node -r tsconfig-paths/register scripts/migrate-sequelize.ts up",
    "db:migrate:down": "ts-node -r tsconfig-paths/register scripts/migrate-sequelize.ts down",
    "account:create": "ts-node -r tsconfig-paths/register scripts/create-account.ts"
  },
  "dependencies": {
    "@moderta/api-contracts": "^0.3.10",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/sequelize": "^11.0.1",
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "umzug": "^3.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.11.10",
    "@types/validator": "^13.15.10",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.9",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
