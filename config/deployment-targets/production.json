{
  "account": "${AWS_ACCOUNT_ID}",
  "region": "${AWS_REGION}",
  "cluster": "${ECS_CLUSTER_NAME}",
  "service": "${ECS_SERVICE_NAME}",
  "family": "${ECS_TASK_FAMILY}",
  "schemaFamily": "${ECS_SCHEMA_FAMILY}",
  "container": "${ECS_CONTAINER_NAME}",
  "database": "${DB_NAME}",
  "runtimeUser": "${DB_APP_USER}",
  "migratorUser": "${DB_MIGRATOR_USER}",
  "rdsIdentifier": "${RDS_INSTANCE_IDENTIFIER}",
  "dbHost": "${DB_HOST}",
  "rdsSecurityGroupId": "${RDS_SECURITY_GROUP_ID}",
  "ecsHostSecurityGroupId": "${ECS_HOST_SECURITY_GROUP_ID}",
  "dbAppPasswordSecretArn": "${DB_APP_PASSWORD_SECRET_ARN}",
  "dbMigratorPasswordSecretArn": "${DB_MIGRATION_PASSWORD_SECRET_ARN}",
  "jwtSecretArn": "${JWT_SECRET_ARN}",
  "ghcrSecretArn": "${GHCR_SECRET_ARN}",
  "infraRoleName": "${INFRA_ROLE_NAME}",
  "deployRoleName": "${APP_DEPLOY_ROLE_NAME}",
  "executionRoleName": "${ECS_EXECUTION_ROLE_NAME}",
  "runtimeRoleName": "${ECS_TASK_ROLE_NAME}",
  "logGroup": "${CLOUDWATCH_LOG_GROUP}",
  "alarmPrefix": "${CLOUDWATCH_ALARM_PREFIX}",
  "port": 3001,
  "publicIngressEnabled": false,
  "sqsEnabled": false
}
