# --- App ---
PORT=3001
# Defaults to production when unset. FRONTEND_URL is then required.
NODE_ENV=development
# Only origin allowed by CORS, and base URL of the password-reset link emailed to users.
FRONTEND_URL=http://localhost:5173

# --- Supabase (shared project; roles live in app_metadata.gaia) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-the-anon-public-key
# Server-side only. Never expose to the frontend, logs or version control.
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-service-role-key

# --- Database (Sequelize + Postgres; docker compose reads these for the postgres service too) ---
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=gaia

# --- Queue (AI work runs through queues; the service layer never sees the transport) ---
# memory = in-process queues plus a stub AI worker (development). sqs = AWS SQS. Required when NODE_ENV=production.
QUEUE_DRIVER=memory
# Required when QUEUE_DRIVER=sqs. Credentials come from the default AWS chain (ECS task role), never from this file.
AWS_REGION=
AI_TASK_QUEUE_URL=
AI_STATUS_QUEUE_URL=
# Only for LocalStack / ElasticMQ.
QUEUE_ENDPOINT=
# Set to false on instances that should only publish and not consume status events.
QUEUE_CONSUMERS_ENABLED=true

# --- File storage (generated files such as exports) ---
# Folder used by the local file store. Defaults to ./storage.
STORAGE_LOCAL_DIR=

# --- Optional, accepted but unused for now ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- LEGACY: used only by npm run account:create (scripts also read the DB_* values above)
ACCOUNT_EMAIL=admin@gaia.local
ACCOUNT_PASSWORD=change-me
ACCOUNT_NAME=Gaia Admin
